def estimatePiShard(var iterations : double, var idx : double, var points : array) {
    var i : double;
    var x : double;
    var y : double;
    var dist_sq : double;
    var points_in_circle : double;
    
    points_in_circle = 0.0;
    i = 0.0;
    while(i < iterations) {
        exec RAND(x);
        exec RAND(y);
        dist_sq = x * x + y * y;
        if (dist_sq <= 1.0) {
            points_in_circle = points_in_circle + 1.0;
        }
        i = i + 1.0;
    }
    points[idx] = points_in_circle;
}

var points[4] : array;
var total_iterations_per_thread : double;
total_iterations_per_thread = 2000000.0;

threadStart(t0) {
    exec estimatePiShard(total_iterations_per_thread, 0.0, points);
}

threadStart(t1) {
    exec estimatePiShard(total_iterations_per_thread, 1.0, points);
}

threadStart(t2) {
    exec estimatePiShard(total_iterations_per_thread, 2.0, points);
}

threadStart(t3) {
    exec estimatePiShard(total_iterations_per_thread, 3.0, points);
}

var estimated_pi : double;
var total_points_in_circle : double;
var total_iterations : double;

threadOnEnd(t0, t1, t2, t3, 1) {
    var zero : double;
    var one : double;
    var two : double;
    var three : double;
    zero = 0.0;
    one = 1.0;
    two = 2.0;
    three = 3.0;

    total_points_in_circle = points[zero];
    total_points_in_circle = total_points_in_circle + points[one];
    total_points_in_circle = total_points_in_circle + points[two];
    total_points_in_circle = total_points_in_circle + points[three];
    
    total_iterations = 8000000.0;
    estimated_pi = 4.0 * total_points_in_circle / total_iterations;
}
